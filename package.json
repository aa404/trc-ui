{
  "name": "trc-ui-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w trc-ui",
    "build:docs": "npm run build -w trc-ui && npm run build -w docs",
    "dev:docs": "npm run dev -w docs",
    "dev:playground": "npm run dev -w playground",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w trc-ui"
  }
}
